# Standard PostgreSQL connection string. Supabase pooler/direct URLs are compatible.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/garimora
# Comma-separated Supabase Auth administrator UUIDs. Enforced server-side.
ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

# Optional: set to 0 to disable the database-free storefront in development.
# This flag can never enable DEMO when NODE_ENV=production.
GARIMORA_DEMO=1
